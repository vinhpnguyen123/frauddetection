# Copy to .env and replace the password. .env is gitignored.
POSTGRES_USER=finbudai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finbudai

# Host-side URLs for tests and native tools. Compose overrides them for its containers.
# Ports 55432/56379 avoid clashing with a Postgres or Redis already installed on the host.
DATABASE_URL=postgresql+asyncpg://finbudai:change-me@127.0.0.1:55432/finbudai
REDIS_URL=redis://127.0.0.1:56379/0
