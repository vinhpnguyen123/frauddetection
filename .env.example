# Copy to .env and replace the password. .env is gitignored.
POSTGRES_USER=frauddetection
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frauddetection

# Host-side URLs for tests and native tools. Compose overrides them for its containers.
# Ports 55432/56379 avoid clashing with a Postgres or Redis already installed on the host.
DATABASE_URL=postgresql+asyncpg://frauddetection:change-me@127.0.0.1:55432/frauddetection
REDIS_URL=redis://127.0.0.1:56379/0
EMBEDDER_URL=http://127.0.0.1:8001

# Models for `make embedder`. Revisions are pinned because nomic-embed runs code from the Hub.
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_MODEL_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
EMBED_CODE_REVISION=7710840340a098cfb869c4f65e87cf2b1b70caca
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a

# Password for the fictional users created by `make seed`.
SEED_PASSWORD=change-me

# Contact address in the User-Agent of `make download` (docs/DATASET.md §4).
DOWNLOAD_CONTACT_EMAIL=you@example.com
